---
import "../styles/global.css";
import fontState from "../styles/font-state.css?raw";
import fontBootstrap from "../scripts/font-bootstrap.js?raw";
import { genFaces } from "virtual:gen-fonts";

const faces = [
  ...genFaces,
  { family: "Zen Kaku Gothic New", weight: 400, url: "/fonts/zen-400-afc9ed33e392.woff2", preload: true },
];
const fontFaces = faces.map(({ family, weight, url }) => `
@font-face {
  font-family: "${family}";
  font-style: normal;
  font-weight: ${weight};
  font-display: block;
  src: url("${url}") format("woff2");
}`).join("\n");
---

<!doctype html>
<html lang="ja" data-theme="light" data-animation="off">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <!-- Paint the canvas and native controls correctly while external CSS loads. -->
    <style is:inline>
      html[data-theme="light"] {
        color-scheme: light;
        background-color: var(--color-white, #fff);
      }
      html[data-theme="dark"] {
        color-scheme: dark;
        background-color: var(--color-gray-900, #111827);
      }
    </style>
    <!-- Run before external stylesheets, without waiting for a module download. -->
    <script is:inline>
      (function () {
        const defaultPreferences = { theme: "light", animation: "off" };
        const preferenceKeys = { theme: "theme", animation: "animation" };

        {
          let theme = defaultPreferences.theme;
          let animation = defaultPreferences.animation;
          const read = (key) => {
            try {
              return localStorage.getItem(key);
            } catch {
              return null;
            }
          };
          const storedTheme = read(preferenceKeys.theme);
          const storedAnimation = read(preferenceKeys.animation);
          if (storedTheme === "light" || storedTheme === "dark")
            theme = storedTheme;
          if (storedAnimation === "off" || storedAnimation === "on")
            animation = storedAnimation;
          const root = document.documentElement;
          root.classList.toggle("dark", theme === "dark");
          root.dataset.theme = theme;
          root.dataset.animation = animation;
          document
            .querySelector('meta[name="color-scheme"]')
            ?.setAttribute("content", theme);
        }
      })();
    </script>
    <style is:inline set:html={fontFaces + fontState} />
    {faces.filter((face) => face.preload).map((face) => (
      <link rel="preload" href={face.url} as="font" type="font/woff2" crossorigin="anonymous" />
    ))}
    <script is:inline set:html={fontBootstrap} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>タカハシタカユキのポートフォリオ</title>
    <meta
      name="description"
      content="東京都在住のフロントエンドエンジニア、タカハシタカユキのポートフォリオ。WordPressを中心としたサイト制作の技術・強み・成果物を紹介しています。"
    />
  </head>
  <body class="relative font-sans px-6 pt-12 pb-3 sm:px-12 sm:pt-12 sm:pb-6 md:px-16 md:pt-16 md:pb-8 2xl:px-32 2xl:pt-32 2xl:pb-16 bg-white text-gray-900 dark:bg-gray-900 dark:text-gray-100">
    <header class="relative">
      <h1
        class="logo-random-reveal text-logo font-zen header_logo w-fit pb-16 2xl:pb-32"
        data-logo-random-reveal
        aria-label="タカハシ タカユキ のポートフォリオ"
      >
        <!-- prettier-ignore -->
        <span aria-hidden="true"><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="タ">タ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="カ">カ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="ハ">ハ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="シ">シ</span><br><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="タ">タ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="カ">カ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="ユ">ユ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="キ">キ</span><br><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="の">の</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="ポ">ポ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="ー">ー</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="ト">ト</span><br><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="フ">フ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="ォ">ォ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="リ">リ</span><span class="relative inline-block opacity-100" data-logo-char data-reveal-text="オ">オ</span></span>
      </h1>
      <div
        class="header-preferences absolute top-0 right-0 flex flex-wrap justify-end gap-x-4 gap-y-2 max-w-full invisible text-sm leading-[1.8] data-[enhanced]:visible max-[600px]:static max-[600px]:flex-col max-[600px]:items-start"
        role="group"
        aria-label="表示設定"
        data-preference-controls
      >
        <button
          type="button"
          class="min-h-[44px] py-2 px-[0.2em] whitespace-nowrap underline underline-offset-[0.2em] cursor-pointer"
          data-animation-toggle
          aria-pressed="false"
          title="アニメーションを動かす"
          disabled
        >
          モーション：オフ
        </button>
        <button
          type="button"
          class="min-h-[44px] py-2 px-[0.2em] whitespace-nowrap underline underline-offset-[0.2em] cursor-pointer"
          data-theme-toggle
          aria-pressed="false"
          title="ダークテーマに切り替える"
          disabled
        >
          テーマ：ライト
        </button>
      </div>
      <nav
        id="fixed-nav"
        aria-label="ページ内ナビゲーション"
        class="fixed-nav fixed z-50 top-1/2 right-0 -translate-y-1/2 text-[1.2rem] leading-[1.5] font-sans font-normal"
      >
        <button
          type="button"
          class="fixed-nav__menu-button grid place-items-center w-[44px] min-h-[44px] px-[8px] py-[12px] cursor-pointer"
          data-menu-button
          popovertarget="fixed-nav-popover"
          aria-controls="fixed-nav-popover"
          aria-label="コンテンツメニュー"
        >
          <span
            class="fixed-nav__lines grid justify-items-end items-center auto-rows-[18px] max-sm:w-full max-sm:grid-cols-1"
            aria-hidden="true"
          >
            <span
              class="fixed-nav__line w-[20px] h-[2px] rounded-none bg-[#b4b4b4] data-[current]:w-[28px] data-[current]:h-[4px] data-[current]:bg-black dark:bg-gray-500 dark:data-[current]:bg-white max-sm:w-[calc(var(--body-padding)-8px)] max-sm:data-[current]:w-[var(--body-padding)]"
              data-section-line="#section01"
            ></span>
            <span
              class="fixed-nav__line w-[20px] h-[2px] rounded-none bg-[#b4b4b4] data-[current]:w-[28px] data-[current]:h-[4px] data-[current]:bg-black dark:bg-gray-500 dark:data-[current]:bg-white max-sm:w-[calc(var(--body-padding)-8px)] max-sm:data-[current]:w-[var(--body-padding)]"
              data-section-line="#section02"
            ></span>
            <span
              class="fixed-nav__line w-[20px] h-[2px] rounded-none bg-[#b4b4b4] data-[current]:w-[28px] data-[current]:h-[4px] data-[current]:bg-black dark:bg-gray-500 dark:data-[current]:bg-white max-sm:w-[calc(var(--body-padding)-8px)] max-sm:data-[current]:w-[var(--body-padding)]"
              data-section-line="#section03"
            ></span>
            <span
              class="fixed-nav__line w-[20px] h-[2px] rounded-none bg-[#b4b4b4] data-[current]:w-[28px] data-[current]:h-[4px] data-[current]:bg-black dark:bg-gray-500 dark:data-[current]:bg-white max-sm:w-[calc(var(--body-padding)-8px)] max-sm:data-[current]:w-[var(--body-padding)]"
              data-section-line="#section04"
            ></span>
          </span>
        </button>
        <div
          id="fixed-nav-popover"
          class="fixed-nav__popover fixed top-1/2 right-[44px] bottom-auto left-auto [translate:0_-50%] m-0 w-[14.4rem] max-w-[calc((100vw-60px)*0.8)] max-h-[calc(100dvh-32px)] overflow-y-auto overscroll-contain p-5 border border-[#e5e5e5] rounded-none bg-white text-[#525252] shadow-[0_12px_32px_rgb(0_0_0/8%)] dark:bg-gray-900 dark:text-gray-300 dark:border-gray-700"
          popover="auto"
          data-contents-item
        >
          <ul id="contents-options" class="grid gap-1">
            <li>
              <a
                class="flex items-center min-h-[44px] p-2 [overflow-wrap:anywhere] aria-[current=location]:text-black aria-[current=location]:font-bold dark:aria-[current=location]:text-white"
                href="#section01"
              >
                自己紹介
              </a>
            </li>
            <li>
              <a
                class="flex items-center min-h-[44px] p-2 [overflow-wrap:anywhere] aria-[current=location]:text-black aria-[current=location]:font-bold dark:aria-[current=location]:text-white"
                href="#section02"
              >
                技術
              </a>
            </li>
            <li>
              <a
                class="flex items-center min-h-[44px] p-2 [overflow-wrap:anywhere] aria-[current=location]:text-black aria-[current=location]:font-bold dark:aria-[current=location]:text-white"
                href="#section03"
              >
                強み
              </a>
            </li>
            <li>
              <a
                class="flex items-center min-h-[44px] p-2 [overflow-wrap:anywhere] aria-[current=location]:text-black aria-[current=location]:font-bold dark:aria-[current=location]:text-white"
                href="#section04"
              >
                成果物
              </a>
            </li>
          </ul>
        </div>
      </nav>
    </header>
    <main>
      <section
        id="section01"
        aria-labelledby="section01-heading"
        class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]"
      >
        <header>
          <p class="section-number text-body mt-[0.5em]" aria-hidden="true">
            [01]
          </p>
          <h2
            id="section01-heading"
            class="heading-reveal relative w-fit text-display section-inset-x mt-[4rem]"
            data-heading-reveal
            data-reveal-text="自己紹介"
            aria-label="自己紹介"
          >
            自己紹介
          </h2>
        </header>
        <div class="section-inset-x mt-[4rem]">
          <div class="text-body font-sans font-light">
            <p>
              はじめまして。タカハシタカユキと申します。
              <br />
              都内のWeb制作会社で、コーダーとして勤務しています。
              <br />
              1986年生まれですが、業務歴は3年弱です。
              <br />
              主に静的サイトの制作保守やWordPressの構築を担当しています。
              <br />
              Webアクセシビリティとモダンフロントエンドに興味があり、日々学習しています。
            </p>
          </div>
        </div>
      </section>
      <section
        id="section02"
        aria-labelledby="section02-heading"
        class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]"
      >
        <header>
          <p class="section-number text-body mt-[0.5em]" aria-hidden="true">
            [02]
          </p>
          <h2
            id="section02-heading"
            class="heading-reveal relative w-fit text-display section-inset-x mt-[4rem]"
            data-heading-reveal
            data-reveal-text="技術"
            aria-label="技術"
          >
            技術
          </h2>
        </header>
        <div class="section-inset-x mt-[4rem]">
          <ul
            role="list"
            class="text-body font-sans font-light grid max-w-[1600px] gap-12 xl:grid-cols-2 xl:gap-x-24 xl:gap-y-12"
          >
            <li>
              <h3 class="text-body font-medium">HTML</h3>
              <p class="mt-4">
                セマンティックなマークアップを意識し、Web標準に準拠したUIを実装します。制作過程では、Nu
                Html Checkerやmarkuplintによる検証を適宜行い、品質を担保します。
              </p>
            </li>
            <li>
              <h3 class="text-body font-medium">CSS</h3>
              <p class="mt-4">
                業務ではMindBEMdingを意識し、既存プロジェクトのルールに沿ったCSS設計・実装を行っています。個人開発ではTailwind
                CSSをよく使用しており、ユーティリティファーストな開発にも対応できます。
              </p>
            </li>
            <li>
              <h3 class="text-body font-medium">JavaScript</h3>
              <p class="mt-4">
                業務では、アニメーションなどの演出を実装するためのVanilla
                JavaScriptの記述や、既存ライブラリの導入・調整を主に行っています。個人開発では、TypeScript、React、Next.js、Astroを学びながら実装に取り組んでいます。
              </p>
            </li>
            <li>
              <h3 class="text-body font-medium">WordPress</h3>
              <p class="mt-4">
                業務では、クラシックエディタとAdvanced Custom
                Fieldsを用いたテーマ開発を多く経験しています。また、セキュリティに配慮した実装を心がけています。
              </p>
            </li>
            <li>
              <h3 class="text-body font-medium">Accessibility</h3>
              <p class="mt-4">
                JIS X
                8341-3:2016への適合を目指す既存サイトの改修を担当しました。日々の案件でも、可能な限りWCAG
                2.2に沿った実装を心がけています。また、DHS Trusted
                Tester認定を取得し、WCAG
                2.0に基づいたWebアクセシビリティ試験を実施できます。
              </p>
            </li>
            <li>
              <h3 class="text-body font-medium">Git</h3>
              <p class="mt-4">
                基本的なGit操作に加え、GitHub
                Flowによるブランチ運用を理解しています。変更内容が追いやすいコミットを意識し、ブランチの作成からプルリクエスト、レビュー、マージまで、チーム開発の流れに沿って作業できます。
              </p>
            </li>
          </ul>
        </div>
      </section>
      <section
        id="section03"
        aria-labelledby="section03-heading"
        class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]"
      >
        <header>
          <p class="section-number text-body mt-[0.5em]" aria-hidden="true">
            [03]
          </p>
          <h2
            id="section03-heading"
            class="heading-reveal relative w-fit text-display section-inset-x mt-[4rem]"
            data-heading-reveal
            data-reveal-text="強み"
            aria-label="強み"
          >
            強み
          </h2>
        </header>
        <div class="section-inset-x mt-[4rem]">
          <ul
            role="list"
            class="text-body font-sans font-light grid max-w-[1600px] gap-12 xl:grid-cols-2 xl:gap-x-24 xl:gap-y-0"
          >
            <li>
              <h3 class="text-body font-medium">知的好奇心</h3>
              <p class="mt-4">
                技術への探究心を原動力に、日々の学習を習慣として継続しています。書籍や有料のイベントなど複数のインプット手段を用い、体系的な知識と最新の動向を取り入れています。
                さらに、週末には学んだ内容を実際に手を動かして実装し、知識を実践で使えるスキルへと定着させています。
              </p>
            </li>
            <li>
              <h3 class="text-body font-medium">業務改善意欲</h3>
              <p class="mt-4">
                チーム全体の生産性と品質を高めるため、自ら課題を見つけて改善に取り組んできました。
                コーダー向けの勉強会を主催し、社内への知識共有を推進しています。
                さらに、知識が組織の資産として残る環境を目指し、業務上の暗黙知のドキュメント化を進めています。
              </p>
            </li>
          </ul>
        </div>
      </section>
      <section
        id="section04"
        aria-labelledby="section04-heading"
        class="border-t border-gray-900 dark:border-gray-100 mt-[8rem]"
      >
        <header>
          <p class="section-number text-body mt-[0.5em]" aria-hidden="true">
            [04]
          </p>
          <h2
            id="section04-heading"
            class="heading-reveal relative w-fit text-display section-inset-x mt-[4rem]"
            data-heading-reveal
            data-reveal-text="成果物"
            aria-label="成果物"
          >
            成果物
          </h2>
        </header>
        <div class="section-inset-x mt-[4rem]">
          <div
            data-text-cards
            class="block max-w-[1600px] ml-0 text-inherit font-sans font-light"
            style="--drop-distance: 0.85; --column-gap: 56px; --three-column-gaps: 112px; --details-font-size: calc(var(--font-trace) * 0.12); --mobile-card-ratio: 35 / 15.4; --wide-card-ratio: 43 / 22; --mobile-card-half-height: 7.7; --wide-card-half-height: 11"
            data-soft="false"
            data-controls="false"
            data-animate="true"
            data-distance="0.85"
            data-interval="140"
            data-max-columns="2"
          >
            <script is:inline>
              {
                const root = document.currentScript.parentElement;
                if (
                  root.dataset.animate === "true" &&
                  document.documentElement.dataset.animation === "on" &&
                  matchMedia("(prefers-reduced-motion: no-preference)").matches
                ) {
                  // Run while parsing, before any card can be painted at its resting position.
                  root.dataset.state = "pending";
                  document.addEventListener(
                    "DOMContentLoaded",
                    () => {
                      // A blocked or failed entry module must leave the static cards usable.
                      if (root.dataset.state === "pending")
                        root.dataset.state = "static";
                    },
                    { once: true },
                  );
                }
              }
            </script>
            <div
              class="controls w-[min(280px,100%)] mt-0 mr-0 mb-4 ml-auto hidden"
              data-controls-container
              hidden
            ></div>
            <div class="stage relative" data-stage>
              <ul
                class="grid grid-cols-1 xl:grid-cols-2 gap-y-[100px] gap-x-[var(--column-gap)] m-0 p-0 list-none"
                role="list"
                aria-label="成果物一覧"
              >
                <li
                  class="entry min-w-0"
                  style="--item-color: #4F5A6B; --item-text: #fff"
                >
                  <article>
                    <div
                      class="object object--image [container-type:size] relative grid place-items-center aspect-[var(--mobile-card-ratio)] sm:aspect-[var(--wide-card-ratio)] p-0 overflow-hidden rounded-[5px] text-[var(--item-text)] bg-[var(--item-color)] origin-center dark:shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)]"
                      data-card
                    >
                      <img
                        class="absolute inset-[4%] w-[92%] h-[92%] max-w-none object-cover object-top pointer-events-none"
                        src="/front-dispatch-2026.vercel.app_.png"
                        alt=""
                        width="1920"
                        height="992"
                        decoding="async"
                      />
                    </div>
                    <h3 class="card-title details-title mt-[14px] max-w-full font-sans text-body font-medium leading-[1.8] tracking-normal text-left [overflow-wrap:anywhere]">
                      技術ブログ
                    </h3>
                    <p class="link mt-1 font-sans text-[length:var(--details-font-size)] font-light leading-[1.8] [overflow-wrap:anywhere] text-pretty">
                      <a
                        class="text-inherit underline underline-offset-[0.15em] hover:decoration-2"
                        href="https://thinking-in-the-grey.pages.dev/"
                        target="_blank"
                        rel="noreferrer"
                        aria-label="https://thinking-in-the-grey.pages.dev/（別ウィンドウで開きます）"
                      >
                        https://thinking-in-the-grey.pages.dev/
                        <svg
                          class="external-link-icon inline-block w-[0.85em] h-[0.85em] ms-[0.3em] align-[-0.05em]"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          width="16"
                          height="16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="M14 3h7v7M21 3 10 14"></path>
                          <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5"></path>
                        </svg>
                      </a>
                    </p>
                    <p class="description mt-[14px] font-sans text-[length:var(--details-font-size)] font-light leading-[1.8] [overflow-wrap:anywhere] text-pretty">
                      microCMS、Astroを使用しブログを作成しました。Swupによる擬似的な非同期遷移も実装しました。
                    </p>
                    <p class="link details-link relative z-2 mt-[14px] font-sans text-[length:var(--details-font-size)] font-light leading-[1.8] [overflow-wrap:anywhere] text-pretty">
                      <a
                        class="text-inherit underline underline-offset-[0.15em] hover:decoration-2"
                        href="https://thinking-in-the-grey.pages.dev/blog/ekgrhcgdn/"
                        target="_blank"
                        rel="noreferrer"
                        aria-label="技術ブログの詳しい説明を見る（別ウィンドウで開きます）"
                      >
                        詳しい説明を見る
                        <svg
                          class="external-link-icon inline-block w-[0.85em] h-[0.85em] ms-[0.3em] align-[-0.05em]"
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 24 24"
                          width="16"
                          height="16"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="M14 3h7v7M21 3 10 14"></path>
                          <path d="M10 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-5"></path>
                        </svg>
                      </a>
                    </p>
                  </article>
                </li>
                <li
                  class="entry min-w-0"
                  style="--item-color: #4F5A6B; --item-text: #fff"
                >
                  <article>
                    <div
                      class="object object--image [container-type:size] relative grid place-items-center aspect-[var(--mobile-card-ratio)] sm:aspect-[var(--wide-card-ratio)] p-0 overflow-hidden rounded-[5px] text-[var(--item-text)] bg-[var(--item-color)] origin-center dark:shadow-[inset_0_0_0_1px_rgb(255_255_255/0.12)]"
                      data-card
                    >
                      <img
                        class="absolute inset-[4%] w-[92%] h-[92%] max-w-none object-cover object-top pointer-events-none"
                        src="/reservation-01.vercel.app_.png"
